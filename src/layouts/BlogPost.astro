---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORY_LABELS } from '../consts';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, category, tags = [] } = Astro.props;
---

<html lang="ko">
	<head><BaseHead title={title} description={description} /></head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<header class="post-header">
					<div class="meta"><a href={`/categories/${category}/`}>{CATEGORY_LABELS[category]}</a> · <FormattedDate date={pubDate} /></div>
					<h1>{title}</h1>
					<p>{description}</p>
					{updatedDate && <p class="updated">Updated: <FormattedDate date={updatedDate} /></p>}
					{tags.length > 0 && <div class="chips">{tags.map((tag) => <a href={`/tags/${tag}/`}>#{tag}</a>)}</div>}
				</header>
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
