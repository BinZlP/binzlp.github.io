---
import { render } from 'astro:content';
import BlogLayout from './BlogLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { blogUi, localePath, postSlug, type BlogLang, type Post } from '../lib/blog';

interface Props {
	post: Post;
	lang: BlogLang;
	alternatePath: string | null;
}
const { post, lang, alternatePath } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
const { Content } = await render(post);
---
<BlogLayout {title} {description} {lang} {alternatePath}>
	<article class="prose">
		<header class="post-header">
			<div class="meta"><a href={localePath(lang, `/categories/${category}/`)}>{blogUi[lang].category[category]}</a> · <FormattedDate date={pubDate} {lang} /></div>
			<h1>{title}</h1>
			<p>{description}</p>
			{updatedDate && <p class="updated">{lang === 'ko' ? '마지막 수정' : 'Updated'} <FormattedDate date={updatedDate} {lang} /></p>}
			{tags.length > 0 && <div class="chips">{tags.map(tag => <a href={localePath(lang, `/tags/${tag}/`)}>#{tag}</a>)}</div>}
		</header>
		<Content />
	</article>
	<section class="prose post-comments" aria-label={lang === 'ko' ? '댓글' : 'Comments'}>
		<div class="giscus" id="comments">
			<noscript>
				<a href="https://github.com/BinZlP/binzlp.github.io/discussions">
					{lang === 'ko' ? 'GitHub에서 토론 보기' : 'View discussions on GitHub'}
				</a>
			</noscript>
		</div>
		<script
			is:inline
			src="https://giscus.app/client.js"
			data-repo="BinZlP/binzlp.github.io"
			data-repo-id="R_kgDOSgj7vA"
			data-category="Announcements"
			data-category-id="DIC_kwDOSgj7vM4DL9p7"
			data-mapping="specific"
			data-term={postSlug(post)}
			data-strict="1"
			data-reactions-enabled="1"
			data-input-position="top"
			data-theme="light"
			data-lang={lang}
			data-loading="lazy"
			crossorigin="anonymous"
			async
		></script>
	</section>
</BlogLayout>

<style>
	.post-comments {
		margin-block-start: 3rem;
		padding-block-start: 2rem;
		border-top: 1px solid rgb(var(--border));
	}
</style>
