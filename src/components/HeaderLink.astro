---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	exact?: boolean;
}

const { href, exact = false, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const target = href.replace(/\/+$/, '');
const currentPage = pathname === target;
const currentSection = !exact && target !== '' && pathname.startsWith(target + '/');
---

<a href={href} aria-current={currentPage ? 'page' : currentSection ? 'location' : undefined} {...props} class:list={[className, { active: currentPage || currentSection }]}>
	<slot />
</a>
<style>
	a {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.38rem 0.72rem;
		border-radius: 9999px;
		color: rgb(var(--gray));
		font-size: 0.86rem;
		font-weight: 550;
		text-decoration: none;
	}
	a:hover { color: rgb(var(--black)); background: #fff; }
	a.active {
		color: var(--accent);
		background: var(--accent-soft);
		box-shadow: 0 0 0 1px rgba(29, 78, 216, 0.12);
	}
	@media (max-width: 420px) {
		a { min-height: 2rem; padding-inline: 0.47rem; font-size: 0.8125rem; }
	}
</style>
