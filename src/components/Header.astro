---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/" aria-label={SITE_TITLE}><span>BinZIP</span><small>tech blog</small></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/categories">Categories</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/BinZlP" target="_blank" rel="noreferrer">
				<span class="sr-only">BinZIP GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(255, 255, 255, 0.82);
		border-bottom: 1px solid rgba(13, 13, 13, 0.08);
		backdrop-filter: blur(18px) saturate(160%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1040px;
		margin: 0 auto;
		padding: 0.75rem 1rem;
	}
	h2 { margin: 0; font-size: 1rem; letter-spacing: -0.02em; }
	h2 a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.38rem;
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 700;
	}
	h2 small { color: rgb(var(--gray)); font-size: 0.78rem; font-weight: 500; letter-spacing: 0; }
	nav a { text-decoration: none; }
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.25rem;
		border-radius: 9999px;
		background: rgba(250, 250, 250, 0.86);
		box-shadow: 0 0 0 1px rgba(13, 13, 13, 0.06);
	}
	.social-links, .social-links a { display: flex; align-items: center; }
	.social-links a {
		justify-content: center;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 9999px;
		color: rgb(var(--gray));
		box-shadow: 0 0 0 1px rgba(13, 13, 13, 0.08);
		background: #fff;
	}
	.social-links a:hover { color: var(--accent); transform: translateY(-1px); }
	@media (max-width: 720px) {
		nav { align-items: flex-start; flex-direction: column; padding: 0.75rem; }
		.internal-links { flex-wrap: wrap; border-radius: 18px; }
		.social-links { display: none; }
	}
</style>
