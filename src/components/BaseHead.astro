---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { localePath, otherLang, type BlogLang } from '../lib/blog';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	lang?: BlogLang;
	alternatePath?: string | null;
}

const {
	title,
	description,
	image = FallbackImage,
	lang = 'ko',
	alternatePath = localePath(otherLang(lang), Astro.url.pathname),
} = Astro.props;
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const alternateURL = alternatePath ? new URL(alternatePath, site) : null;
const defaultURL = lang === 'en' && alternateURL ? alternateURL : canonicalURL;
const imageURL = new URL(image.src, site);
const socialLocales = { ko: 'ko_KR', en: 'en_US' } as const;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} (${lang === 'ko' ? '한국어' : 'English'})`}
	href={new URL(localePath(lang, '/rss.xml'), site)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={lang} href={canonicalURL} />
{alternateURL && <link rel="alternate" hreflang={otherLang(lang)} href={alternateURL} />}
<link rel="alternate" hreflang="x-default" href={defaultURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={socialLocales[lang]} />
{alternateURL && <meta property="og:locale:alternate" content={socialLocales[otherLang(lang)]} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
