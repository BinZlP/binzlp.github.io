---
import { Image } from 'astro:assets';
import FormattedDate from '../FormattedDate.astro';
import { blogUi, postUrl, type BlogLang, type Post } from '../../lib/blog';

interface Props {
	posts: Post[];
	lang: BlogLang;
	heading?: 'h2' | 'h3';
	showCategory?: boolean;
}
const { posts, lang, heading: Heading = 'h2', showCategory = true } = Astro.props;
---
<div class="post-list">
	{posts.map(post => (
		<article class="post-card">
			<a href={postUrl(lang, post)} class:list={[{ 'with-thumbnail': post.data.heroImage }]}>
				<span class="meta">{showCategory && `${blogUi[lang].category[post.data.category]} · `}<FormattedDate date={post.data.pubDate} {lang} /></span>
				<Heading>{post.data.title}</Heading>
				<p>{post.data.description}</p>
				{post.data.heroImage && (
					<Image
						class="post-thumbnail"
						src={post.data.heroImage}
						alt={post.data.heroImageAlt ?? ''}
						width={224}
						widths={[112, 224, 448]}
						sizes="(max-width: 40rem) 6.5rem, min(22vw, 14rem)"
					/>
				)}
			</a>
		</article>
	))}
</div>
