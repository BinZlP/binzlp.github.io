---
import type { BlogLang } from '../../lib/blog';

interface Props { lang?: BlogLang }
const { lang = 'ko' } = Astro.props;
const labels = {
	ko: {
		description: '한 요청 안에서는 앞선 토큰 A, B, C의 KV를 읽어 다음 응답 토큰 D를 생성합니다. 두 요청의 입력이 각각 A B X와 A B Y라면, 다음 요청에서는 일치하는 접두부 A B의 KV를 재사용할 수 있습니다.',
		within: '한 요청 안에서', across: '두 요청 사이에서', cached: '앞선 토큰의 KV', generate: '다음 토큰 생성',
		previous: '이전 요청', next: '다음 요청', reuse: '접두부 KV 재사용',
	},
	en: {
		description: 'Within one request, the model reads the KV cache for tokens A, B and C to generate the next token, D. Across two requests with inputs A B X and A B Y, the second request can reuse the cached KV for their shared prefix, A B.',
		within: 'Within one request', across: 'Across two requests', cached: 'Cached KV', generate: 'Next token',
		previous: 'First request', next: 'Next request', reuse: 'Reuse prefix KV',
	},
}[lang];
---

<div class="kv-reuse" lang={lang} role="img" aria-label={labels.description}>
	<div class="cases" aria-hidden="true">
		<div>
			<strong class="case-title">{labels.within}</strong>
			<div class="request generation">
				<div class="step">
					<div class="strip cached"><span>A</span><span>B</span><span>C</span></div>
					<span>{labels.cached}</span>
				</div>
				<i class="arrow-right"></i>
				<div class="step">
					<div class="strip"><span>D</span></div>
					<span>{labels.generate}</span>
				</div>
			</div>
		</div>
		<div>
			<strong class="case-title">{labels.across}</strong>
			<div class="request prompt">
				<span>{labels.previous}</span>
				<div class="strip cached"><span>A</span><span>B</span></div>
				<div class="strip"><span>X</span></div>
			</div>
			<div class="bridge"><i class="arrow-down"></i>{labels.reuse}</div>
			<div class="request prompt">
				<span>{labels.next}</span>
				<div class="strip cached"><span>A</span><span>B</span></div>
				<div class="strip"><span>Y</span></div>
			</div>
		</div>
	</div>
</div>

<style>
	.kv-reuse {
		container-type: inline-size;
		color: var(--kc-ink);
		font-size: 0.875rem;
		line-height: 1.4;
		word-break: keep-all;
	}
	.cases {
		--cell: clamp(1.55rem, 6cqi, 2.125rem);
		--pad: 0.625rem;
		--label: 4.125rem;
		--gap: 0.625rem;
		display: grid;
		gap: 1.5rem;
	}
	.case-title { display: block; margin-bottom: 0.625rem; font-size: 0.9375rem; }
	.kv-reuse[lang="en"] .cases { --label: 5.5rem; }
	.request {
		border: 1px solid var(--kc-rule);
		border-radius: 8px;
		background: var(--kc-paper);
		padding: 0.75rem var(--pad);
	}
	.generation {
		display: grid;
		grid-template-columns: auto minmax(1rem, 1fr) auto;
		align-items: start;
		gap: 0.5rem;
	}
	.step { display: grid; justify-items: center; gap: 0.4rem; color: var(--kc-muted); font-size: 0.8125rem; }
	.strip { display: inline-flex; border: 1px solid var(--kc-rule); border-radius: 4px; color: var(--kc-ink); }
	.strip span {
		display: grid;
		place-items: center;
		width: var(--cell);
		height: 1.6rem;
		font: 500 0.875rem/1 var(--font-mono, monospace);
	}
	.strip span + span { border-inline-start: 1px solid var(--kc-rule); }
	.cached { --kc-rule: var(--kc-blue-rule); color: var(--kc-blue); background: var(--kc-tint); }
	.prompt {
		display: grid;
		grid-template-columns: var(--label) auto auto;
		align-items: center;
		justify-content: start;
		column-gap: var(--gap);
	}
	.prompt > span { font-weight: 550; white-space: nowrap; }
	.bridge {
		/* Align the arrow with the seam between A and B in both requests. */
		margin-inline-start: calc(var(--pad) + var(--label) + var(--gap) + var(--cell) + 2px);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 2rem;
		color: var(--kc-blue);
		font-size: 0.75rem;
	}
	.arrow-right, .arrow-down { display: block; position: relative; color: var(--kc-blue); }
	.arrow-right { margin-block-start: 0.85rem; border-top: 1px solid; }
	.arrow-down { align-self: stretch; border-left: 1px solid; }
	.arrow-right::after, .arrow-down::after {
		content: '';
		position: absolute;
		width: 5px;
		height: 5px;
		border-top: 1px solid;
		border-right: 1px solid;
	}
	.arrow-right::after { right: 0; top: -3px; transform: rotate(45deg); }
	.arrow-down::after { left: -3px; bottom: 1px; transform: rotate(135deg); }
	@container (min-width: 36rem) {
		.cases { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
	}
</style>
