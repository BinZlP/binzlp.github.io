---
import type { BlogLang } from '../lib/blog';

interface Props {
	date: Date;
	lang?: BlogLang;
}

const { date, lang = 'ko' } = Astro.props;
const formatter = new Intl.DateTimeFormat(lang === 'ko' ? 'ko-KR' : 'en-US', {
	year: 'numeric',
	month: lang === 'ko' ? 'long' : 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{formatter.format(date)}</time>
