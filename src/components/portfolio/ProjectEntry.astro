---
import type { PortfolioLink, PortfolioProject } from "../../data/portfolio";
import { portfolioUi, type PortfolioLocale } from "../../data/portfolio-ui";
interface Props {
  project: PortfolioProject;
  company: PortfolioLink;
  locale: PortfolioLocale;
  open?: boolean;
}
const { project, company, locale, open = false } = Astro.props;
const t = portfolioUi[locale];
---

<details class="project-entry" id={project.id} open={open}>
  <summary>
    <span class="project-summary-copy">
      <span class="title-1" role="heading" aria-level="3">
        {project.title}
      </span>
      <span class="caption-2 project-meta">
        <a href={company.href}>{company.label}</a>
        <span aria-hidden="true">{` ${t.separator} `}</span>
        {project.period}
      </span>
      <span class="body-6 project-description">{project.summary}</span>
    </span>
    <span class="disclosure-mark" aria-hidden="true"></span>
  </summary>
  <div class="project-content">
    <dl class="project-facts caption-2">
      <div>
        <dt class="caption-1">{t.role}</dt>
        <dd>{project.role}</dd>
      </div>
      {project.tags && project.tags.length > 0 && (
        <div>
          <dt class="caption-1">{t.technologies}</dt>
          <dd>{project.tags.join(` ${t.separator} `)}</dd>
        </div>
      )}
    </dl>
    {project.image && (
      <figure class="project-image">
        <a
          href={project.image.src}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.openDiagram(project.title)}
        >
          <img
            src={project.image.src}
            alt={project.image.alt}
            width={project.image.width}
            height={project.image.height}
          />
        </a>
        <figcaption class="caption-5">
          {project.image.caption}{" "}
          <a href={project.image.src} target="_blank" rel="noopener noreferrer">
            {t.fullSize} ↗
          </a>
        </figcaption>
      </figure>
    )}
    <div class="case-section">
      <h4 class="title-4">{t.motivation}</h4>
      <ul class="body-3">
        {project.motivation.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
    <div class="case-section">
      <h4 class="title-4">{t.description}</h4>
      <ul class="body-3">
        {project.description.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
    <div class="case-section">
      <h4 class="title-4">{t.achievements}</h4>
      <ul class="achievement-list body-3">
        {project.achievements.map((point) => (
          <li>
            <strong class="body-1">{point.title}</strong>
            <p>{point.text}</p>
          </li>
        ))}
      </ul>
    </div>
    {project.links.length > 0 && (
      <div class="reference-links caption-1">
        {project.links.map((link) => (
          <a href={link.href}>{link.label} ↗</a>
        ))}
      </div>
    )}
    <a class="project-permalink caption-5" href={`#${project.id}`}>
      {t.permalink}
    </a>
  </div>
</details>
