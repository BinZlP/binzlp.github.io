---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORY_LABELS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Systems · AI · Software Engineering</p>
				<h1>BinZIP tech blog</h1>
				<p class="subtitle">시스템, AI, 개발 생산성, 그리고 IT 흐름을 기록하는 기술 블로그입니다.</p>
				<div class="actions"><a href="/blog/">Read posts</a><a href="/about/">About</a></div>
			</section>
			<section>
				<h2>Latest posts</h2>
				<div class="post-list">
					{latestPosts.map((post) => (
						<article class="post-card">
							<a href={`/blog/${post.id}/`}>
								<span class="meta">{CATEGORY_LABELS[post.data.category]} · <FormattedDate date={post.data.pubDate} /></span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</article>
					))}
				</div>
			</section>
			<section>
				<h2>Categories</h2>
				<div class="chips">{Object.entries(CATEGORY_LABELS).map(([slug, label]) => <a href={`/categories/${slug}/`}>{label}</a>)}</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
