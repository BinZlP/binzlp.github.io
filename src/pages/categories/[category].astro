---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORY_LABELS, SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return Object.keys(CATEGORY_LABELS).map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const posts = (await getCollection('blog')).filter((post) => post.data.category === category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const label = CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS];
---
<!doctype html>
<html lang="ko">
	<head><BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label} posts`} /></head>
	<body><Header /><main><h1>{label}</h1><div class="post-list">{posts.map((post) => <article class="post-card"><a href={`/blog/${post.id}/`}><span class="meta"><FormattedDate date={post.data.pubDate} /></span><h2>{post.data.title}</h2><p>{post.data.description}</p></a></article>)}</div></main><Footer /></body>
</html>
