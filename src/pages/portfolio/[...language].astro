---
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import { portfolioAssetUrl } from "../../lib/portfolio-asset-url";
import ProjectEntry from "../../components/portfolio/ProjectEntry.astro";
import * as english from "../../data/portfolio";
import * as korean from "../../data/portfolio.ko";
import * as englishDiagrams from "../../data/portfolio-diagrams";
import * as koreanDiagrams from "../../data/portfolio-diagrams.ko";
import { portfolioUi, type PortfolioLocale } from "../../data/portfolio-ui";

export function getStaticPaths() {
  return [
    { params: { language: undefined }, props: { locale: "en" } },
    { params: { language: "ko" }, props: { locale: "ko" } },
  ];
}

interface Props {
  locale: PortfolioLocale;
}
const { locale } = Astro.props;
const t = portfolioUi[locale];
const {
  profile, companies, projects, experience, earlierProjects, presentations,
  writings, activities, skills, education, awards,
} = locale === "ko" ? korean : english;
const { projectDiagrams, researchDiagrams } = locale === "ko" ? koreanDiagrams : englishDiagrams;
const sections = [
  "profile", "experience", "projects", "presentations", "writings", "activities", "skills", "awards",
] as const;
const illustratedProjects = projects.map((project) => {
  const diagram = projectDiagrams[project.id];
  if (!diagram) return project;
  return { ...project, image: { ...diagram, src: portfolioAssetUrl(diagram.src) } };
});
---

<PortfolioLayout locale={locale} profile={profile}>
  <div class="portfolio-shell">
    <aside class="document-index">
      <p class="caption-1 index-label">{t.contents}</p>
      <nav aria-label={t.index}>
        {sections.map((id) => (
          <a class="title-4" href={`#${id}`}>
            {t[id]}
            {id === "projects" && (
              <span class="caption-5">{projects.length}</span>
            )}
          </a>
        ))}
      </nav>
      <div class="index-contact caption-2">
        <a href={profile.github}>GitHub ↗</a>
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <a href={`mailto:${profile.email}`}>{t.email} ↗</a>
      </div>
    </aside>
    <main id="main" class="document">
      <details class="mobile-index">
        <summary class="title-4">{t.mobileIndex}</summary>
        <nav aria-label={t.index}>
          {sections.map((id) => (
            <a class="body-6" href={`#${id}`}>
              {t[id]}
            </a>
          ))}
        </nav>
      </details>
      <section
        class="profile-section document-section"
        id="profile"
        aria-labelledby="profile-title"
      >
        <h1 class="heading-1" id="profile-title">
          {profile.name}
        </h1>
        <p class="title-1 profile-role">{profile.role}</p>
        <p class="body-3 profile-intro">{profile.intro}</p>
        <div class="profile-links body-6">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github}>GitHub</a>
          <a href={profile.linkedin}>LinkedIn</a>
        </div>
        <div class="education-list">
          {education.map((item) => (
            <div>
              <p class="title-4">{item.school}</p>
              <p class="body-6">{item.degree}</p>
              <p class="caption-5">{item.period}</p>
            </div>
          ))}
        </div>
      </section>
      <section
        class="document-section"
        id="experience"
        aria-labelledby="experience-title"
      >
        <h2 class="heading-4 section-title" id="experience-title">
          {t.experience}
        </h2>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-entry">
              <div class="experience-heading">
                <h3 class="heading-6"><a href={companies[item.company].href}>{companies[item.company].label}</a></h3>
                <p class="caption-2">{item.period}</p>
              </div>
              <p class="title-4 experience-role">{item.role}</p>
              <p class="body-3">{item.description}</p>
              {item.bullets && (
                <ul class="body-3 experience-bullets">
                  {item.bullets.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
      <section
        class="document-section"
        id="projects"
        aria-labelledby="projects-title"
      >
        <div class="section-heading-row">
          <h2 class="heading-4 section-title" id="projects-title">
            {t.projects}
          </h2>
          <button
            type="button"
            class="expand-projects button-xsm"
            data-expand-projects
            data-expand={t.expand}
            data-collapse={t.collapse}
            aria-pressed="false"
            hidden
          >
            {t.expand}
          </button>
        </div>
        <p class="body-6 section-intro">
          {t.projectIntro}
        </p>
        <div class="project-list">
          {illustratedProjects.map((project, index) => (
            <ProjectEntry locale={locale} project={project} company={companies[project.company]} open={index === 0} />
          ))}
        </div>
        <details class="earlier-work">
          <summary class="title-3">
            {t.earlier}{" "}
            <span class="caption-5">{earlierProjects.length}</span>
          </summary>
          <div class="earlier-list">
            {earlierProjects.map((item) => (
              <article>
                <div class="publication-heading">
                  <h3 class="title-3">{item.title}</h3>
                  <span class="caption-5">{item.period}</span>
                </div>
                <p class="body-6">{item.description}</p>
              </article>
            ))}
          </div>
        </details>
      </section>
      <section
        class="document-section"
        id="presentations"
        aria-labelledby="presentations-title"
      >
        <h2 class="heading-4 section-title" id="presentations-title">
          {t.presentations}
        </h2>
        <div class="publication-list">
          {presentations.map((item) => (
            <article>
              <p class="caption-2 publication-meta">{item.meta}</p>
              <h3 class="heading-6">{item.title}</h3>
              <p class="body-3">{item.description}</p>
              {item.links.length > 0 && (
                <div class="reference-links caption-1">
                  {item.links.map((link) => (
                    <a href={link.href}>{link.label} ↗</a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
      <section
        class="document-section"
        id="writings"
        aria-labelledby="writings-title"
      >
        <h2 class="heading-4 section-title" id="writings-title">
          {t.writings}
        </h2>
        <div class="publication-list">
          {writings.map((item) => (
            <article>
              <p class="caption-2 publication-meta">{item.meta}</p>
              <h3 class="heading-6">{item.title}</h3>
              <p class="body-3">{item.description}</p>
              {item.links.length > 0 && (
                <div class="reference-links caption-1">
                  {item.links.map((link) => (
                    <a href={link.href}>{link.label} ↗</a>
                  ))}
                </div>
              )}
              {item.title.startsWith("ScaleOPT") && (
                <details class="research-diagrams">
                  <summary class="caption-1">{t.researchDiagrams}</summary>
                  {researchDiagrams.map(({ src, alt, width, height, caption }) => (
                    <figure class="project-image">
                      <img src={portfolioAssetUrl(src)} alt={alt} width={width} height={height} />
                      <figcaption class="caption-5">{caption}</figcaption>
                    </figure>
                  ))}
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
      <section
        class="document-section"
        id="activities"
        aria-labelledby="activities-title"
      >
        <h2 class="heading-4 section-title" id="activities-title">
          {t.activities}
        </h2>
        <dl class="reference-list">
          {activities.map((item) => (
            <div>
              <dt class="title-4">{item.title}</dt>
              <dd class="body-3">
                {Array.isArray(item.description) ? (
                  <ul class="activity-roles">
                    {item.description.map((role) => <li>{role}</li>)}
                  </ul>
                ) : item.description}
              </dd>
            </div>
          ))}
        </dl>
      </section>
      <section
        class="document-section"
        id="skills"
        aria-labelledby="skills-title"
      >
        <h2 class="heading-4 section-title" id="skills-title">
          {t.skills}
        </h2>
        <dl class="reference-list skills-list">
          {skills.map((item) => (
            <div>
              <dt class="title-4">{item.title}</dt>
              <dd class="body-3">{item.items.join(` ${t.separator} `)}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section
        class="document-section"
        id="awards"
        aria-labelledby="awards-title"
      >
        <h2 class="heading-4 section-title" id="awards-title">
          {t.awards}
        </h2>
        <dl class="award-list">
          {awards.map((item) => (
            <div>
              <dt class="caption-2">{item.year}</dt>
              <dd class="body-3">{item.title}</dd>
            </div>
          ))}
        </dl>
      </section>
    </main>
  </div>
</PortfolioLayout>
<script>
  const entries = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".project-entry"),
  );
  const alternate = document.querySelector<HTMLAnchorElement>("[data-language-link]");
  const setAlternateTarget = (id: string) => {
    if (alternate) alternate.hash = id;
  };
  entries.forEach((entry) => {
    entry.querySelector("summary")?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) return;
      setAlternateTarget(entry.open ? "projects" : entry.id);
    });
  });
  const expandButton = document.querySelector<HTMLButtonElement>(
    "[data-expand-projects]",
  );
  const updateExpandButton = () => {
    if (!expandButton) return;
    const allOpen = entries.every((entry) => entry.open);
    expandButton.textContent = (allOpen ? expandButton.dataset.collapse : expandButton.dataset.expand) ?? "";
    expandButton.setAttribute("aria-pressed", String(allOpen));
  };
  if (expandButton) {
    expandButton.hidden = false;
    expandButton.addEventListener("click", () => {
      const open = !entries.every((entry) => entry.open);
      entries.forEach((entry) => {
        entry.open = open;
      });
      updateExpandButton();
    });
    entries.forEach((entry) =>
      entry.addEventListener("toggle", updateExpandButton),
    );
  }
  const revealHashTarget = () => {
    let id: string;
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    setAlternateTarget(target ? id : "");
    if (target instanceof HTMLDetailsElement) target.open = true;
    if (target)
      requestAnimationFrame(() =>
        target.scrollIntoView({ block: "start", behavior: "instant" }),
      );
  };
  revealHashTarget();
  window.addEventListener("hashchange", revealHashTarget);
  window.addEventListener("load", revealHashTarget);
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      ".document-index nav a, .mobile-index nav a",
    ),
  );
  const sectionElements = Array.from(
    document.querySelectorAll<HTMLElement>(".document-section"),
  );
  const updateCurrentSection = () => {
    const readingLine = Math.min(window.innerHeight * 0.25, 200);
    const current =
      sectionElements.findLast(
        (section) => section.getBoundingClientRect().top <= readingLine,
      ) ?? sectionElements[0];
    if (!current) return;
    navLinks.forEach((link) => {
      if (link.hash === `#${current.id}`)
        link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  let scrollFrame: number | undefined;
  const scheduleSectionUpdate = () => {
    if (scrollFrame !== undefined) return;
    scrollFrame = requestAnimationFrame(() => {
      scrollFrame = undefined;
      updateCurrentSection();
    });
  };
  window.addEventListener("scroll", scheduleSectionUpdate, { passive: true });
  window.addEventListener("resize", scheduleSectionUpdate);
  window.addEventListener("load", scheduleSectionUpdate);
  entries.forEach((entry) =>
    entry.addEventListener("toggle", scheduleSectionUpdate),
  );
  updateCurrentSection();
  navLinks.forEach((link) =>
    link.addEventListener("click", () => {
      const mobileIndex =
        document.querySelector<HTMLDetailsElement>(".mobile-index");
      if (mobileIndex) mobileIndex.open = false;
    }),
  );
  let printState: boolean[] = [];
  const allDetails = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(
      ".project-entry, .earlier-work, .research-diagrams",
    ),
  );
  window.addEventListener("beforeprint", () => {
    printState = allDetails.map((entry) => entry.open);
    allDetails.forEach((entry) => {
      entry.open = true;
    });
  });
  window.addEventListener("afterprint", () => {
    allDetails.forEach((entry, index) => {
      entry.open = printState[index] ?? entry.open;
    });
  });
</script>
